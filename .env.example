# Copy this file to .env locally, then fill in your own values.
# NEVER commit real tokens, passwords, or database connection strings.

# ---- required ----
BOT_TOKEN=replace_with_telegram_bot_token
ADMIN_IDS=123456789
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/YOUR_DB?retryWrites=true&w=majority
QC_API_BASE=https://your-quickcodes-api.example.com

# ---- optional ----
BOT_TITLE=Nexora
SUPPORT_LINK=@your_support_username
WP_GUIDE_URL=
DB_NAME=reseller_bot

# ---- optional two-channel force join ----
# For public channels, use @channelusername as CHANNEL and https://t.me/channelusername as LINK.
# For private channels, CHANNEL must be the numeric chat ID (usually -100...), and LINK the invite URL.
FORCE_JOIN_CHANNEL_1=
FORCE_JOIN_LINK_1=
FORCE_JOIN_CHANNEL_2=
FORCE_JOIN_LINK_2=
